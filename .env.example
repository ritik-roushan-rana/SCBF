# SCBF explanation config — copy to .env and fill in.
#
#   cp .env.example .env && chmod 600 .env
#
# .env is gitignored and a pre-commit hook refuses staged keys, but the safest
# place on a shared or long-lived machine is still /etc/scbf/explain.env, which
# is root-owned, mode 600, and outside the source tree entirely. scbf-explain
# reads that first and falls back to this file.

SCBF_EXPLAIN_PROVIDER=groq

# groq    console.groq.com/keys          starts gsk_
# gemini  aistudio.google.com/apikey     starts AIza
# anthropic                              starts sk-ant-
# ollama  no key needed — runs locally
GROQ_API_KEY=

# Optional: override the model. Default per provider is in scbf/explain/explain.py
# SCBF_EXPLAIN_MODEL=openai/gpt-oss-120b
