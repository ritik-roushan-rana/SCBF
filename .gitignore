.vscode/
*.code-workspace
.idea/
*.swp
*.swo
*~
.DS_Store

# Jupyter
.ipynb_checkpoints/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log
training.pid

# Temporary
*.tmp

# NPM preprocessing caches (hundreds of MB, rebuilt automatically by train_npm_hybrid)
models/checkpoints_npm/npm_preprocessed_cache*.pt
